function setMedidas() {

  if ($("#flagCla").val() == "s") {
    var v =
      $("#largo").val() +
      "x" +
      $("#alto").val() +
      "x" +
      $("#ancho").val() +
      "cm";
    var pt = $("#peso").val() + "kg";
    var vt = "$" + $("#valorContenido").val();
    $("#medi").val(v);
    $("#mediL").text(v);
    $("#pesoTotal").val(pt);
    $("#pesoTotalL").text(pt);
    $("#valor").val(vt);
    $("#valorL").text(vt);
  }
}

function controladorEstado2() {
  $("#eDestino")
    .find("input, select")
    .each(function () {
      $(this).on("input", function () {
        $(this).removeClass("border border-danger");
        $("#nf3").addClass("d-none");
      });

      $(this).on("change", function () {
        var n = $(this).attr("id");
        if ($("#" + n + " option:selected").val() != "-1") {
          $(this).removeClass("border border-danger");
          $("#nf3").addClass("d-none");
        }
      });
    });
}

function cambiarClass(id, clase1, clase2) {
  $(id).removeClass(clase1);
  $(id).addClass(clase2);
}

function nuevos_envios(target) {
  // var target = $('a[data-bs-toggle="tab"]').attr("href");
  if (target == "#panel2") {
    $("#destino").removeClass("botontab-estadoinicial");
    // $('#ulenvios').css('background-position-y','-33px');
    cambiarClass("#envio", "botontab", "botontabsel");
    cambiarClass("#destino", "botontab", "botontabsel");
    cambiarClass("#producto", "botontabsel", "botontab");
    cambiarClass("#iconop2", "falta", "");
    $("#panel1, #panel3").removeClass("active show");
    $("#etiqueta-datosdel").html("Destino");
    $("#envio-destino-nombre").focus();
  } else if (target == "#panel3") {
    $("#producto").removeClass("botontab-estadoinicial");
    // $('#ulenvios').css('background-position-y','-66px');
    cambiarClass("#envio", "botontab", "botontabsel");
    cambiarClass("#destino", "botontab", "botontabsel");
    cambiarClass("#producto", "botontab", "botontabsel");
    cambiarClass("#iconop3", "falta", "");

    $("#panel1, #panel1").removeClass("active show");
    $("#panel1, #panel2").addClass("visited show");
    $("#etiqueta-datosdel").html("Paquete");
    $("#tipo_producto").focus();
  } else if (target == "#panel1") {
    // $('#ulenvios').css('background-position-y','0px');
    cambiarClass("#envio", "botontab", "botontabsel");
    cambiarClass("#destino", "botontabsel", "botontab");
    cambiarClass("#producto", "botontabsel", "botontab");
    cambiarClass("#iconop1", "falta", "");

    $("#panel2, #panel3").removeClass("active show");
    $("#etiqueta-datosdel").html("Origen");
    $("#envio-origen-provincia").focus();
  }
  let $curr = $(".tabenvios a[href='" + target + "']").parent();
  $(".tabenvios li").removeClass();

  $curr.addClass("active");
  $curr.prevAll().addClass("visited");
  $(".tabenvios li").addClass("lienvios");

  $("#ulenvios li").each(function () {
    if ($(this).hasClass("visited") || $(this).hasClass("active")) {
      let $i = $(this).find("i");
      $i.removeClass("bi-circle");
      $i.addClass("bi-circle-fill");
    } else {
      let $i = $(this).find("i");
      $i.addClass("bi-circle");
      $i.removeClass("bi-circle-fill");
    }
  });
}

