function mostrarOcultar2(obj) {
  var c = "#" + $(obj).attr("id") + "2";
  $(obj).on("click", function () {
    if ($(this).hasClass("bi-chevron-down")) {
      $(this).removeClass("bi-chevron-down");
      $(this).addClass("bi-chevron-up");

      if ($(c).hasClass("d-none")) {
        $(c).removeClass("d-none");
      } else {
        $(c).addClass("d-none");
      }
    } else {
      $(this).removeClass("bi-chevron-up");
      $(this).addClass("bi-chevron-down");

      if ($(c).hasClass("d-none")) {
        $(c).removeClass("d-none");
      } else {
        $(c).addClass("d-none");
      }
    }
  });
}

function mostrarOcultar(obj) {
  $(obj).on("click", function () {
    if ($(this).hasClass("bi-chevron-down")) {
      $(this).removeClass("bi-chevron-down");
      $(this).addClass("bi-chevron-up");

      if ($(this).attr("id") == "mosOri") {
        $("#ediOriContenido").hide("slow");
      }
      if ($(this).attr("id") == "mosPaq") {
        $("#mosPaqContenido").hide("slow");
      }
    } else {
      $(this).removeClass("bi-chevron-up");
      $(this).addClass("bi-chevron-down");

      if ($(this).attr("id") == "mosOri") {
        $("#ediOriContenido").show("slow");
      }
      if ($(this).attr("id") == "mosPaq") {
        $("#mosPaqContenido").show("slow");
      }
    }
  });
}

function soloNumerosEnteros(obj) {
  $(obj).on("input", function () {
    this.value = this.value.replace(/[^0-9]/g, "");
  });
}

function soloAlfaNumerico(obj) {
  $(obj).on("input", function () {
    //var t = $(this).val();
    if (this.value.length > 30) {
      this.value = this.value.substring(0, this.value.length - 1);
    } else {
      this.value = this.value.replace(/[^0-9A-Za-z]/g, "");
    }
  });
}

//-- que permite el ingreso de solo numero enteros con un limite de ingreso
// Para códigos de área: no permite 0 como primer dígito
function soloNumerosConLimite(obj, limite) {
  $(obj).on("input", function () {
    if (this.value.length > limite || this.value[0] == "0") {
      this.value = this.value.substring(0, this.value.length - 1);
    } else {
      this.value = this.value.replace(/[^0-9]/g, "");
    }
  });
}

// Para celulares: solo controla el límite, permite cualquier dígito
function soloNumerosConLimiteSinRestriccionCero(obj, limite) {
  $(obj).on("input", function () {
    if (this.value.length > limite) {
      this.value = this.value.substring(0, limite);
    } else {
      this.value = this.value.replace(/[^0-9]/g, "");
    }
  });
}

//-- funcion para convertir a float
//-- REUIERE: input con los valores maximos en la vista, uno es modificable por el js
//-- y el otro trabaja como swap para restablecer al primero acorde a la condicion del
//-- codigo.
function converFloat(obj) {
  $(obj).on("input", function () {
    if (
      this.value.length > $("#limitePrecio").val() ||
      (this.value[0] == "0" && this.value[1] == "0")
    ) {
      this.value = this.value.substring(0, this.value.length - 1);
    } else {
      this.value = this.value.replace(/[^0-9,]/g, "");
      if (this.value.includes(",") === true) {
        var n = 0;
        for (var i = 0; i < this.value.length; i++) {
          if (this.value[i] === ",") {
            n += 1;
            var t = i + 3;
            $("#limitePrecio").val(t);
          }
        }
        if (n > 1) {
          this.value = this.value.substring(0, this.value.length - 1);
        }
      } else {
        $("#limitePrecio").val($("#limitePrecioSwap").val());
      }
    }
  });
}

function pesoConDecimales(obj) {
  $(obj).on("input", function () {
    var enteroLimite = 2;
    var decimalLimite = 5;
    this.value = this.value.replace(/[^0-9,]/g, "");
    var coma = 0;
    if (
      this.value.length == 2 &&
      this.value[0] == "0" &&
      this.value[1] == "0"
    ) {
      this.value = this.value.substring(0, this.value.length - 1);
    }

    if (
      this.value.length > enteroLimite &&
      this.value.includes(",") === false
    ) {
      this.value = this.value.substring(0, this.value.length - 1);
    } else {
      if (this.value.includes(",") === true) {
        var can = 0;
        for (var i = 0; i < this.value.length; i++) {
          if (this.value[i] === ",") {
            can += 1;
            coma = i;
          }
        }
        if (can > 1) {
          this.value = this.value.substring(0, this.value.length - 1);
        }
        if (coma == 2) {
          this.value = this.value.substring(0, this.value.length + 1);
          decimalLimite = 6;
        }
      }

      if (
        coma == 2 &&
        decimalLimite == 6 &&
        this.value.includes(",") === true &&
        this.value.length == 6 &&
        this.value.length < 7
      ) {
        this.value = this.value.substring(0, this.value.length + 1);
      }

      if (this.value.length > decimalLimite) {
        this.value = this.value.substring(0, this.value.length - 1);
      }
    }
  });
}

//--  seccion para validacion de valores maximo relacionados a nuevos envios y medidas frecuentes  --------------------//

//-- funcion booleana que valida los valores entre dos objetos
//-- compara obj1.val <= obj2.val
//-- obj2.val debe contener el valor maximo que obj1 no debe superar.
function medidaValida(obj1, obj2) {
  //console.log("Ingresado: " + $(obj1).val() + " - Limite: " + $(obj2).val());
  return Number($(obj1).val()) <= Number($(obj2).val());
}

//-- esta funcion realiza el control de los diferentes valor y los mensajes sobre los diferentes
//-- limite. Es solo para la seccion de nuevos envios.
function controlMesajeErrorMedidas() {
  var mje = "";
  var total =
    Number($("#largo").val()) +
    Number($("#ancho").val()) +
    Number($("#alto").val());
  var tope = Number($("#maximo_laa").val());
  var limit = tope;
  if (!medidaValida($("#largo"), $("#maximo_largo"))) {
    mje +=
      "El largo debe ser menor o igual a " +
      $("#maximo_largo").val() +
      " cm.<br/>";
    $("#largo").addClass("border border-danger");
  }
  if (!medidaValida($("#ancho"), $("#maximo_ancho"))) {
    mje +=
      "El ancho debe ser menor o igual a " +
      $("#maximo_ancho").val() +
      " cm.<br/>";
    $("#ancho").addClass("border border-danger");
  }
  if (!medidaValida($("#alto"), $("#maximo_altura"))) {
    mje +=
      "El alto debe ser menor o igual a " +
      $("#maximo_altura").val() +
      " cm.<br/>";
    $("#alto").addClass("border border-danger");
  }
  if (total > tope) {
    mje +=
      "La suma (largo + ancho + alto) debe ser menor o igual a " +
      limit +
      " cm.<br/>";
  }
  //if (!medidaValida($('#peso'), $('#pesoMaximoPermitido'))) {
  if (!medidaValidaPeso(conversorPeso($("#peso")))) {
    mje +=
      "El peso debe ser menor o igual a " +
      $("#pesoMaximoPermitido").val() +
      " Kg.<br/>";
    $("#peso").addClass("border border-danger");
  }
  if ($("#peso").val() == "0") {
    mje += "El peso debe ser mayor a 0 (cero).<br/>";
    $("#peso").addClass("border border-danger");
  }
  if ($("#valorContenido").val() == "0") {
    mje += "El valor debe ser mayor a 0 (cero).<br/>";
    $("#valorContenido").addClass("border border-danger");
  }
  $("#nf_maximo_medidas").removeClass("d-none");
  $("#nf_maximo_medidas > small").html(mje);
  return mje === "";
}

function controlMesajeErrorResumen() {
  var mje = "";

  if ($("#medi").val() == "") {
    mje += "Para poder continuar debe completar Medidas.<br/>";
  }
  if ($("#pesoTotal").val() == "") {
    mje += "Para poder continuar debe completar Peso.<br/>";
  }
  if ($("#valor").val() == "") {
    mje += "Para poder continuar debe completar Valor.<br/>";
  }

  if (mje !== "") {
    $("#nf_resumen_faltante").removeClass("d-none");
    $("#nf_resumen_faltante > small").html(mje);
    return false;
  }
  $("#nf_resumen_faltante").addClass("d-none");
  return true;
}
function conversorPeso(obj) {
  var pesoSwap = $(obj).val().replace(",", ".");
  return Math.round(Number(pesoSwap) * 1000);
}

function medidaValidaPeso(peso) {
  var maxPeso = Number($("#pesoMaximoPermitido").val());
  maxPeso = maxPeso * 1000;
  //console.log("Ingresado: " + peso + " - Limite: " + maxPeso);
  return peso <= maxPeso;
}
//---------------------------------------------------------------------------------------------------------------------//

function conversorDecimal(obj) {
  $(obj).on("input", function () {
    var v = $(this).val();
    if (v.length > 3) {
      var n = "";
      var indicador = v.length - 3;
      for (var i = 0; i < v.length; i++) {
        if (i == indicador) {
          //n.charAt('.');
          n = n + ".";
          n = n + v[i];
        } else if (v[i] != ".") {
          n = n + v[i];
        }
        //n.charAt(v[i]);
      }
      $(this).val(n);
    }
  });
}

