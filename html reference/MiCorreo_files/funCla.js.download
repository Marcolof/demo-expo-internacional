function applyMsgStyleSucu() {
  const css = `
/* estilo por defecto del contenedor (no forzamos a los hijos) */
#mensajespaqueteria {
  font-size: 16px;
  line-height: 1.25;
  font-weight: 400;
  text-decoration: none;
  box-sizing: border-box;
}
#mensajespaqueteria small { display:block; margin-top:.25rem; }

/* estilo cuando el contenedor tiene la clase error-msg */
/* usamos alta especificidad y !important para evitar que otras reglas lo pisen */
#mensajespaqueteria.error-msg {
  background-color: #FFD0D0 !important;
  color: #d32f2f !important;
  border: 1px solid #f5c2c2 !important;
  border-radius: 6px !important;
  padding: 8px 12px !important;
  margin: 6px 0 !important;
  font-size: 14px !important;
  line-height: 1.2 !important;
  display: block !important;
}

/* asegurar que el texto dentro también sea rojo cuando el contenedor es error */
#mensajespaqueteria.error-msg, 
#mensajespaqueteria.error-msg * {
  color: #d32f2f !important;
}

/* opcional: limitar ancho para que no tape botones */
#mensajespaqueteria.error-msg { max-width: 100%; }
`;
  // reemplaza o crea el style node con id fijo
  const id = "msgStyle17";
  const existing = document.getElementById(id);
  if (existing) {
    existing.textContent = css;
  } else {
    $("<style id='" + id + "'>").text(css).appendTo(document.head);
  }
}

function validarCamposCompletosSucu() {
  const v = sel => String($(sel).val() || "").trim();

  applyMsgStyleSucu();

  const allOk =
    v("#nars2") !== "" &&
    $("#provincia2").val() !== "-1" &&
    $("#sucursalDestino2").val() !== "-1" &&
    v("#correoElectronico2") !== "" &&
    v("#codAreaPaqSuc") !== "" &&
    v("#celularPaqSuc") !== "" &&
    $("#producTi").val() !== "-1";

  $("#pagar")
    .prop("disabled", !allOk)
    .toggleClass("btn-pagar", allOk)
    .toggleClass("btn-pagar-d", !allOk);

  return allOk;
}

