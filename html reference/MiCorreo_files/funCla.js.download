//--------------  mapa sucursal origen  --------------------------------------------------------------------//
function initMapSucOrigen() {
  mapSuc = L.map("mapSuc").setView([-34.6158238, -58.4332985], 14); // por defecto 13
  L.tileLayer("https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/capabaseargenmap@EPSG%3A3857@png/{z}/{x}/{-y}.png", {
    maxZoom: 19,
    attribution: "",
  }).addTo(mapSuc);
}
function LimpiarMapaOrigen() {
  for (let i = 0; i < markersOrigen.length; i++) {
    mapSuc.removeLayer(markersOrigen[i]);
  }
  markersOrigen = [];
}
function setUpPointSucOrigen() {
  $("#sucursalOrigen").on("change", function () {
    var provCod = $("#sucursalProvinciaOrigen option:selected").val();
    var codSuc = $("#sucursalOrigen option:selected").val();
    LimpiarMapaOrigen();
    $.post(la_url + "/getCoordenadas",
      {
        token: $("input[name='_token']").val(),
        codProv: provCod,
        codSuc: codSuc,
        tipo: "I",
      },
      function (data) {
        if (data.length) {
          data = data[0];

          //pongo las marcas de todas las provincias para que pueda ver las distintas opciones de sucursales
          for (i = 0; i < data.sucursales_provincia.length; i++) {
            if (data.sucursales_provincia[i].latitud != null && data.sucursales_provincia[i].longitud != null) {
              var n = [data.sucursales_provincia[i].latitud, data.sucursales_provincia[i].longitud];
              let sucu = data.sucursales_provincia[i].codigoSucursal;

              var marker = L.marker(n).addTo(mapSuc)
                .on('click', function () {
                  $("#sucursalOrigen").val(sucu);
                  // $("#"+sucu).prop("selected", true);
                  // console.log(sucu);

                })
                .bindPopup(`
  <span class="popup-title">${data.sucursales_provincia[i].descripcion}</span>
  <div class="popup-address">${data.sucursales_provincia[i].domicilio}</div>
  <div class="popup-hours">
    ${(data.sucursales_provincia[i].horario || '').replace(/\s*\/\s*/g, '<br>')}
  </div>
`)

              //servirá para limpiar el mapa
              markersOrigen.push(marker);
            }

          }

          var n = [data.position.lat, data.position.lng];
          mapSuc.flyTo(n, 15);
          var marker = L.marker(n).addTo(mapSuc)
            .on('click', function () {
              $("#sucursalOrigen").val(codSuc);
            })

            .bindPopup(`
  <span class="popup-title">${data.datos_sucursal.descripcion}</span>
  <div class="popup-address">${data.datos_sucursal.domicilio}</div>
  <div class="popup-hours">
    ${(data.datos_sucursal.horario || '').replace(/\s*\/\s*/g, '<br>')}
  </div>
`).openPopup();

          markers.push(marker);

          console.log(data, n);
        }
      }
    );
  });
}

function initModEnvio() {

  window.isEditing = true;
  window.sucDestinoNue = modEnvioData["destino_sucursal"];

  //-- step one
  loading();

  // Nombre / Apellido
  $("#inputOrigen").val(modEnvioData["origen_nombre"]);
  $("#origen").addClass("trueOne");

  if (modEnvioData["logistica"] == "drop_off") {
    $("#checkSucursal").click();

    $("#sucursalProvinciaOrigen").val(modEnvioData["origen_provincia"]);

    setTimeout(() => $("#sucursalProvinciaOrigen").change(), 1000);

  } else {
    $("#checkPickUp").click();
    $("#dirOrigen option#" + modEnvioData["origen_cp"]).prop("selected", true);
    $("#dirOrigen").change();
  }

  //-- step two

  $("#medidasFrecuentes").val("-1");
  $("#origen").removeClass("trueOne");
  $("#medidasPaquete").addClass("trueTwo");



  $("#largo").val(modEnvioData["largo"]);
  $("#ancho").val(modEnvioData["ancho"]);


  $("#alto").val(modEnvioData["altura"]);


  $("#peso").val(modEnvioData["peso"] / 1000);


  let valCont = modEnvioData["valor"];
  valCont = valCont.replace(",", "") / 100;
  $("#valorContenido").val(valCont);

  setMedidas();

  //-- step three
  $("#nroOpcional").val(modEnvioData["orderNumber"]);
  //tipo Entrega
  $("#tipoEntrega").val(modEnvioData["tipo_entrega"]).trigger("change");
  $("#medidasPaquete").removeClass("trueTwo");
  $("#eDestino").addClass("trueThree");

  // ===============================
  // DESTINO SUCURSAL
  // ===============================
  if (modEnvioData["tipo_entrega"] == "sucursal") {

    $("[id$=D2]").removeClass("d-none");
    $("[id$=D]").addClass("d-none");


    $("#estadoControlDestino").val("sucursal");

    $("#codAreaPaqSuc").val(modEnvioData["destino_cod_area_celular"]);



    $("#nars2").val(modEnvioData["destino_nombre"]);


    $("#correoElectronico2").val(modEnvioData["destino_mail"]);


    $("#celularPaqSuc").val(modEnvioData["destino_celular"]);

    // FIX MAPA: inicialización segura
    ensureMapReady();

    // Provincia destino
    $("#provincia2").val(modEnvioData["destino_provincia"]).change();

    setTimeout(function () {

      // Cargar combo sucursales

      llamadaVCP($("#provincia2"), $("#sucursalDestino2"));

      // Seleccionar sucursal cuando exista
      seleccionarSucursalDestino(modEnvioData["destino_sucursal"]);

      // FIX MAPA: refresco FORZADO (no depende de change)
      refreshMapDestino(
        modEnvioData["destino_provincia"],
        modEnvioData["destino_sucursal"]
      );

      // Texto resumen
      const timerDU = setInterval(function () {
        const $opt = $('#sucursalDestino2 option.' + modEnvioData["destino_sucursal"]);
        if ($opt.length) {
          $("#DU").text(
            $("#provincia2 option:selected").text() + ", " + $opt.text()
          );
          clearInterval(timerDU);
        }
      }, 100);

      // Tipo producto
      $("input[name='tipoProduc'][value='" + modEnvioData["tipo_producto"] + "']")


        .prop("checked", true);

      $("#producTi").val(modEnvioData["tipo_producto"]);
      $("#tipo_producto").val(modEnvioData["tipo_producto"]);

    }, 400);

    $('#camposEntregaDomicilio').css('top', '0px');

  }
  // ===============================
  // DESTINO DOMICILIO
  // ===============================
  else {

    $("[id$=D2]").addClass("d-none");
    $("[id$=D]").removeClass("d-none");
    $("#estadoControlDestino").val("domicilio");
    $("#nars").val(modEnvioData["destino_nombre"]);
    $("#correoElectronico").val(modEnvioData["destino_mail"]);
    $("#codAreaPaqDom").val(modEnvioData["destino_cod_area_celular"]);
    $("#celularPaqDom").val(modEnvioData["destino_celular"]);
    $("#localidad").val(modEnvioData["destino_localidad"]);

    let piso = modEnvioData["destino_piso"] ? ' P: ' + modEnvioData["destino_piso"] : '';
    let depto = modEnvioData["destino_departamento"] ? ' D: ' + modEnvioData["destino_departamento"] : '';

    let direccion = modEnvioData["destino_direccion"]
      ? modEnvioData["destino_direccion"] + (modEnvioData["destino_altura"] != '-' ? ' ' + modEnvioData["destino_altura"] + piso + depto : '')
      : modEnvioData["destino_calle"] + ' ' + modEnvioData["destino_altura"] + piso + depto;

    $("#direCompleta").val(direccion);
    $("#observaciones").val(modEnvioData["destino_observaciones"]);
    $("#provincia").val(modEnvioData["destino_provincia"]).change();
    $("#DU").text($("#provincia option:selected").text());

    setTimeout(function () {
      $("#cpCpa").val(modEnvioData["destino_cp"]);
      llamadaVCP($("#provincia"), $("#cpCpa"));
    }, 1000);
  }

  //-- resumen
  $("#DN").text(modEnvioData["destino_nombre"]);

  setTimeout(() => unloading(), 5000);

}

//-- metodo para controlar el tipo de logistica (pickup, dorpoof)
function controlPickupDropOff() {
  $("input[name='sucursal-pickup']").on("click", function () {
    //alert($(this).attr('id'));
    if ($(this).attr("id") == "checkSucursal") {
      $("#check_pickup").val("no");
    } else {
      $("#check_pickup").val("si");
    }
    // $("#tipoEntrega").change();

  });
}

