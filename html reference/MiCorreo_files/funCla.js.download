function pagar() {
  if ($("#estadoEnvio").val() == "1") {
    console.log('paso validacion pagar');
    $.ajax({
      url: la_url + "/mis-envios-post",
      type: "POST",
      data: {
        token: $("input[name='_token']").val(),
        id_envio: $("#id_envios").val(),
      },
      headers: {
        "x-csrf-token": $("input[name='_token']").val(),
      },
      success: function (res) {
        console.log('pagar okey, hago submit');
        console.log(res);
        $("#formPagar").submit();
      },
      error: function (res) {
        console.log("Error:", res);
      },
    });
  }
}
//----------------------------------------------------------------------------------------------------------------------------------------

/** 
 * onchange para estadoControl y todos los input de la ultima instancia -> pregunto si es sucursal o si es domicilio y consulto por si los campos estan llenos
 * el onchange para estadoControl tiene que evaluar si es 2, sino lo deshabilita
 */
$("#nars2").on("change", function () {
  validarCamposCompletosSucu();
});
$("#provincia2").on("change", function () {
  validarCamposCompletosSucu();
});
$("#sucursalDestino2").on("change", function () {
  validarCamposCompletosSucu();
  if (typeof ensureMapOnEdit === 'function') {
    ensureMapOnEdit();
  }
});
$("#correoElectronico2").on("change", function () {
  validarCamposCompletosSucu();
});
$("#codAreaPaqSuc").on("change", function () {
  validarCamposCompletosSucu();
});
$("#celularPaqSuc").on("change", function () {
  validarCamposCompletosSucu();
});
$("#pqClasic").is(":checked")
$("#pqClasic").on("change", function () {
  if ($('#tipoEntrega').val() == 'sucursal') {
    validarCamposCompletosSucu();
  } else if ($('#tipoEntrega').val() == 'domicilio') {
    validarCamposCompletosDom();
  }
});
$("#pqExpress").on("change", function () {
  if ($('#tipoEntrega').val() == 'sucursal') {
    validarCamposCompletosSucu();
  } else if ($('#tipoEntrega').val() == 'domicilio') {
    validarCamposCompletosDom();
  }
});
$("#pqHoy").on("change", function () {
  if ($('#tipoEntrega').val() == 'sucursal') {
    validarCamposCompletosSucu();
  } else if ($('#tipoEntrega').val() == 'domicilio') {
    validarCamposCompletosDom();
  }
});
$("#tipoEntrega").on("change", function () {
  $("#pagar").attr("disabled", "disabled")
    .removeClass("btn-pagar")
    .addClass("btn-pagar-d");
});

function applyMsgStyleError() {
  const css = `
#mensajeError, #mensajeError * {
  color: #191919 !important;
  font-size: 16px !important;
  line-height: 1.25 !important;
  font-weight: 400 !important;
  text-decoration: none !important;
}
#mensajeError small {
  display: block;
  margin-top: .25rem;
}

/* Fondo único para los mensajes de error */
.error-msg {
  background-color: #FFD0D0;  /* rojo claro */
  color: #d32f2f;             /* rojo oscuro */
  border: 1px solid #FFD0D0;
  border-radius: 6px;
  padding: 8px 12px;
  margin: 6px 0;
  font-size: 14px;
  line-height: 1.2;
  display: block;
}
`;
  const node = document.getElementById("msgStyle20");
  if (node) node.textContent = css;
  else $("<style id='msgStyle20'>").text(css).appendTo(document.head);
}

