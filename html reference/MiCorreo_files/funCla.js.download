$(document)
  .off("change.tipoEntregaDom")
  .on("change.tipoEntregaDom", "#tipoEntrega", function () {
    const $msg = $("#mensajespaqueteria");
    $msg.empty().addClass("d-none").removeClass("error-msg");
    $("#codAreaPaqDom, #celularPaqDom").removeClass("border border-danger is-invalid");
    $("#pagar").prop("disabled", true).removeClass("btn-pagar").addClass("btn-pagar-d");
    limpiarNF3();
    limpiarMensajeError();
    limpiarMensajesPaqueteria();
  })
  .off("click.prevClean")
  .on("click.prevClean", "#prev", function () {
    const $msg = $("#mensajespaqueteria");
    $msg.empty().addClass("d-none").removeClass("error-msg");
    $("#codAreaPaqDom, #celularPaqDom, #codAreaPaqSuc, #celularPaqSuc").removeClass("border border-danger is-invalid");
    $("#pagar").prop("disabled", true).removeClass("btn-pagar").addClass("btn-pagar-d");
    limpiarNF3();
    limpiarMensajeError();
    limpiarMensajesPaqueteria();
  });

// Primera pasada
validarCamposCompletosDom();


function guardarEnvio(esGuardar = true) {
  /*$.post('/guardarPedido', { data: $('#dataSet').find('input').serialize() }, function (data) {
        alert(data);
    });*/
  if (controlMesajeErrorResumen()) {
    var dataSet = $("#dataSet").find("input").serialize();

    if (isEditing) {
      ensureMapOnEdit();
      $.ajax({
        type: "PUT",
        url: la_url + "/envio/" + envioID,
        data: dataSet,
        dataType: "json",
        success: function (result) {
          //console.log(result);
          if (result == undefined || result.error == undefined) {
            $("#error-ne-guardado").removeClass("d-none");
          } else {
            if (result.error == "1") {
              $("#error-ne-guardado").removeClass("d-none");
              console.log(result.msg);
            } else {
              $("#id_envios").val(envioID);
              $("#estadoEnvio").val("1");
              $("#ediOri").css({ color: "#858789", "pointer-events": "none" });
              $("#ediPaq").css({ color: "#858789", "pointer-events": "none" });
              $("#ediDes").css({ color: "#858789", "pointer-events": "none" });
              $("#verifi-ne-guardado").removeClass("d-none");
              $("#next")
                .attr("disabled", "disabled")
                .removeClass("btn-ne-s")
                .addClass("btn-desabilitar-d");
              $("#prev")
                .attr("disabled", "disabled")
                .removeClass("btn-atras-ne")
                .addClass("btn-desabilitar-d");
              limpiarMensajesPaqueteria();
              limpiarMensajeError();
              limpiarNF3();

              if ($("#pp").length) {
                $("#pagar")
                  .removeAttr("disabled")
                  .removeClass("btn-pagar-d")
                  .addClass("btn-pagar");
              }
              if (esGuardar) {
                window.location.href = la_url + '/mis-envios';
              } else {
                //si lo llamo desde pagar, pago
                // console.log('entro a pagar desde guardar');
                $("#pagar").attr("disabled", "disabled")
                  .removeClass("btn-pagar")
                  .addClass("btn-pagar-d");

                pagar();
              }
            }
          }
        },
        error: function (XMLHttpRequest, textStatus, errorThrown) {
          alert2(
            "Se ha producido un error, intenta nuevamente.",
            "window.reload();"
          );
          on_error_session(XMLHttpRequest, textStatus, errorThrown);
        },
        dataFilter: function (data, type) {
          return data;
        },
      });
    } else {
      $.post(la_url + "/guardarPedido", dataSet, function (data) {
        //alert(data);
        var regexIdEnvio = new RegExp("^[0-9]{1,10}$");
        //- data != 'Error'
        if (regexIdEnvio.test(data)) {
          $("#id_envios").val(data);
          $("#estadoEnvio").val("1");
          $("#ediOri").css({ color: "#858789", "pointer-events": "none" });
          $("#ediPaq").css({ color: "#858789", "pointer-events": "none" });
          $("#ediDes").css({ color: "#858789", "pointer-events": "none" });
          $("#verifi-ne-guardado").removeClass("d-none");
          $("#next")
            .attr("disabled", "disabled")
            .removeClass("btn-ne-s")
            .addClass("btn-desabilitar-d");
          $("#prev")
            .attr("disabled", "disabled")
            .removeClass("btn-atras-ne")
            .addClass("btn-desabilitar-d");
          limpiarNF3();
          limpiarMensajesPaqueteria();
          limpiarMensajeError();

          if ($("#pp").length) {
            $("#pagar")
              .removeAttr("disabled")
              .removeClass("btn-pagar-d")
              .addClass("btn-pagar");
          }
          if (esGuardar) {
            window.location.reload();
          } else {
            //si lo llamo desde pagar, pago
            // console.log('entro a pagar desde guardar');
            $("#pagar").attr("disabled", "disabled")
              .removeClass("btn-pagar")
              .addClass("btn-pagar-d");

            pagar();
          }
        } else {
          $("#error-ne-guardado").removeClass("d-none");
        }
      }).fail(function (data) {
        if (data.status == "403") {
          window.location.reload(true);
        }
      });
    }
  }
}
/*
Funcion generica para la validacion de cp-origen y cp-destino
REQUIERE: objeto provicia y codigo postal ingresado por el usuario, funcion llamadaVCP
*/

function checkCP(provincia, codp) {
  //delPer(provincia, codp);

  $(provincia).on("change", function () {
    var n = Number($("#estDD2").val());
    n += 1;
    $("#estDD2").val(n);
    //console.log($(this).attr('id') + " - valor de N: " + n + " - Valor de estDD: " + $('#estDD2').val());
    //if ($('#flagCla').val() == 'n' || n > 2) {
    if ($(codp).val() != "") {
      //$("input[name='tipoProduc']").prop("checked", false);
      if (!$("input[name='tipoProduc']").is(":checked")) {
        $("input[name='tipoProduc']").prop("checked", false);
      }
      llamadaVCP($(provincia), $(codp));
    }
  });
  $(codp).on("input", function () {
    var m = Number($("#estDD2").val());
    m += 1;
    $("#estDD2").val(m);
    //if ($('#flagCla').val() == 'n' || m > 2) {
    if ($(codp).val().length == 4 && $(provincia).val() != "-1") {
      //$("input[name='tipoProduc']").prop("checked", false);
      if (!$("input[name='tipoProduc']").is(":checked")) {
        $("input[name='tipoProduc']").prop("checked", false);
      }
      llamadaVCP($(provincia), $(codp));
    }
    //}
  });
}
function checkCP2(provincia, codp) {
  $(codp).on("change", function () {
    var n = Number($("#estDD").val());
    n += 1;
    $("#estDD").val(n);
    //if ($('#flagCla').val() == 'n' || n > 2) {
    if ($(codp).val().length == 4 && $(provincia).val() != "-1") {
      if (!$("input[name='tipoProduc']").is(":checked")) {
        $("input[name='tipoProduc']").prop("checked", false);
      }
      //$("input[name='tipoProduc']").prop("checked", false);
      llamadaVCP($(provincia), $(codp));
    }
    //}
  });
}

