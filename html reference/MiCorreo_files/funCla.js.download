function obtenerSucOrigen(sucursalUsuario = "") {
  $("#selectSucursalProvOrigen").on("change", function () {

    var e = $("#selectSucursalProvOrigen option:selected").val();
    var action = "I";

    // if (isEditing) {
    ensureMapOnEdit();
    //   $("#sucursalOrigen").val(sucOrigen);
    //   $("#sucursalProvinciaOrigen").val(modEnvioData["origen_provincia"]);
    // }
    if (e != "-1") {
      $.post(la_url + "/consultarSO",
        { token: $("input[name='_token']").val(), codProv: e, action: action },
        function (data) {
          //console.log(JSON.parse(data));
          var res = JSON.parse(data);
          //console.log(res.sucursales);
          $("#sucursalOrigen").empty();
          $("#sucursalOrigen").append(
            $("<option></option>").attr("value", "-1").text("-")
          );
          var sucursalElegida = sucursalUsuario;
          console.log(sucursalUsuario)
          console.log(res.sucursales);
          $.each(res.sucursales, function (i, item) {
            var $opcion = $("<option></option>")
              .attr("value", res.sucursales[i].codigoSucursal)
              .text(res.sucursales[i].descripcion)
              .addClass(res.sucursales[i].cp);
            // console.log(sucursalElegida + "------" +res.sucursales[0].codigoSucursal)

            console.log()
            // Verificar si sucursalUsuario no está vacío
            if (res.sucursales[i].codigoSucursal == test['codigoSucursal']) {
              console.log("es igual a la cabecera")
              $opcion.attr("selected", "selected");
              // $("#sucursalOrigen").change();
            }

            $("#sucursalOrigen").append($opcion);
          });
          //only for modEdit
          if (isEditing) {
            ensureMapOnEdit();
            // $("#sucursalProvinciaOrigen").val(modEnvioData["origen_provincia"]);

            if ((modEnvioData['origen_sucursal'] != null && modEnvioData['origen_sucursal'] != "") && $("#sucursalProvinciaOrigen").val() == modEnvioData["origen_provincia"]) {
              $("#sucursalOrigen").val(modEnvioData['origen_sucursal']);
            }
            if (!document.querySelector("#mapSuc").children.length > 0) {
              initMapSucOrigen();
            }
            $("#sucursalOrigen").change();
          }
          else if (existeSucursalCabecera) {
            if ($("#sucursalProvinciaOrigen").val() == provinciaCabecera) {
              $("#sucursalOrigen").val(test['codigoSucursal']);
            }
            if (!document.querySelector("#mapSuc").children.length > 0) {
              initMapSucOrigen();
            }
            $("#sucursalOrigen").change();
          }
        }
      );
    }
  });
}

function obtenerSucOrigenDest() {

  $("#provincia2").off("change.sucDestino").on("change.sucDestino", function () {

    var codProv = $("#provincia2").val();
    if (codProv === "-1") return;

    $.ajax({
      type: "POST",
      url: la_url + "/checkSesion",
      data: { token: $("input[name='_token']").val() },
      headers: { "x-csrf-token": $("input[name='_token']").val() },
      success: function (respuesta) {

        if (respuesta != 1) {
          window.location.href = "sesion-expirada";
          return;
        }

        $.post(
          la_url + "/consultarSO",
          {
            token: $("input[name='_token']").val(),
            codProv: codProv,
            action: "E"
          },
          function (data) {

            var res = JSON.parse(data);
            var $combo = $("#sucursalDestino2");


            // Limpieza Controlada
            $combo.empty();
            $combo.append(
              $("<option></option>").attr("value", "-1").text("-")
            );

            // cargar sucursales
            $.each(res.sucursales, function (i, s) {
              $combo.append(
                $("<option></option>")
                  .attr("value", s.cp)
                  .text(s.descripcion)
                  .addClass(s.codigoSucursal)
              );
            });

            // =========================
            // MODO EDICIÓN
            // =========================
            if (window.isEditing && window.sucDestinoNue) {

              // seleccionar sucursal
              var $opt = $combo.find("." + window.sucDestinoNue);
              if ($opt.length) {
                $opt.prop("selected", true);
              }

              // refrescar mapa SIN reinit
              ensureMapReady();

              // disparar lógica dependiente
              $combo.trigger("change");
            }

          }
        );
      },
      error: function () {
        window.location.href = "sesion-expirada";


      }
    });

  });
}

