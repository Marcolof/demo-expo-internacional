//-- funcion para evitar que se ingrese caracteres "especiales" y con limite de ingreso
//-- Esta pensada para nombre y/o razones sociales.
function cadenaLimpia(obj, limite) {
  $(obj).on("input", function () {
    if (this.value.length > limite) {
      this.value = this.value.substring(0, this.value.length - 1);
    } else {
      this.value = this.value.replace(/[^0-9A-Za-z\u00C0-\u017F.\s]/g, "");
      for (var i = 0; i < this.value.length; i++) {
        if (i > 0 && this.value[i] == " " && this.value[i - 1] == " ") {
          this.value = this.value.substring(0, this.value.length - 1);
          this.value = this.value.substring(0, this.value.length - 1);
        }
      }
      if (this.value.length == 1 && this.value[0] == " ") {
        this.value = this.value.substring(0, this.value.length - 1);
      }
      //-- backup: \u00f1\u00d1
    }
  });
}
function cadenaLimpia2(obj, limite) {
  $(obj).on("input", function () {
    if (this.value.length > limite) {
      this.value = this.value.substring(0, this.value.length - 1);
    } else {
      this.value = this.value.replace(/[^0-9A-Za-z\u00C0-\u017F:.\s]/g, "");
      // for (var i = 0; i < this.value.length; i++) {
      //   if (i > 0 && this.value[i] == " " && this.value[i - 1] == " ") {
      //     this.value = this.value.substring(0, this.value.length - 1);
      //     this.value = this.value.substring(0, this.value.length - 1);
      //   }
      // }
      if (this.value.length == 1 && this.value[0] == " ") {
        this.value = this.value.substring(0, this.value.length - 1);
      }
      //-- backup: \u00f1\u00d1
    }
  });
}
function quitarEspaciosInicioFinal(obj) {
  return $(obj).val().trim();
}

function limpiarMail(obj) {
  $(obj).on("input", function () {
    this.value = this.value.replace(/[^0-9a-zA-Z.\_\-@]/g, "");
    if (this.value.includes("@") === true) {
      var n = 0;
      var m = 0;
      for (var i = 0; i < this.value.length; i++) {
        if (this.value[i] === "@") {
          n += 1;
          m = i;
        }
      }
      if (n > 1) {
        this.value = this.value.substring(0, this.value.length - 1);
      }
      var alias = this.value[this.value.length - 1];
      if (alias == "_" || alias == "-") {
        this.value = this.value.substring(0, this.value.length - 1);
      }
    }
  });
}

function limpiarTextArea(obj) {
  $(obj).on("input", function () {
    this.value = this.value.replace(/[^0-9a-zA-Z\u00C0-\u017F\s\.\,]/g, "");
  });
}

//--  seccion para activar y desactivar ayuda  -----------------------------------------------//

function activarDesactivar() {
  const tooltipTriggerList = document.querySelectorAll(
    '[data-bs-toggle="tooltipCla"]'
  );
  const tooltipList = [...tooltipTriggerList].map(
    (tooltipTriggerEl) => new bootstrap.Tooltip(tooltipTriggerEl)
  );
  $('[data-bs-toggle="tooltipCla"]').tooltip("disable");
  // id = estadoAyuda
  //$('[id^=help]')
  // $('#help1')
  $("[id^=help]").css("color", "#b6b4b4");
  $("[id^=help]").on("click", function () {
    if ($("#estadoAyuda").val() == "0") {
      $("#estadoAyuda").val("1");
      $("[id^=help]").css("color", "#198754");
      $('[data-bs-toggle="tooltipCla"]').tooltip("enable");
    } else {
      $("#estadoAyuda").val("0");
      $("[id^=help]").css("color", "#b6b4b4");
      $('[data-bs-toggle="tooltipCla"]').tooltip("disable");
    }
  });
}

//--------------------------------------------------------------------------------------------//

function normalizador() {
  $("#prin").on("click", function () {
    /*var cargar = $('#claEn').height();
        var resumen = $('#infoRe').height();
        if (cargar > resumen) {
            $('#infoRe').height(cargar);
        } else {
            $('#claEn').height(resumen);
        }*/
    var altura_arr = []; //CREAMOS UN ARREGLO VACIO
    $(".grid_1_4").each(function () {
      //RECORREMOS TODOS LOS CONTENEDORES DE LAS IMAGENES, DEBEN TENER LA MISMA CLASE
      var altura = $(this).height(); //LES SACAMOS LA ALTURA
      altura_arr.push(altura); //METEMOS LA ALTURA AL ARREGLO
    });
    altura_arr.sort(function (a, b) {
      return b - a;
    }); //ACOMODAMOS EL ARREGLO EN ORDEN DESCENDENTE
    $(".grid_1_4").each(function () {
      //RECORREMOS DE NUEVO LOS CONTENEDORES
      $(this).css("height", altura_arr[0]); //LES PONEMOS A TODOS LOS CONTENEDORES EL PRIMERO ELEMENTO DE ALTURA DEL ARREGLO, QUE ES EL MAS GRANDE.
    });
  });
}

//--------------  mapa  ------------------------------------------------------------------------//
function initMap() {
  if (window.map) return; // 🔥 FIX doble init

  map = L.map("map").setView([-34.6158238, -58.4332985], 14);

  L.tileLayer(
    "https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/capabaseargenmap@EPSG%3A3857@png/{z}/{x}/{-y}.png",
    {
      maxZoom: 19,
      attribution: "",
    }
  ).addTo(map);

}
// lo hago para que el mapa quede limpio despues de cambiar de sucursal (en especial por las provincias)
function LimpiarMapa() {
  for (let i = 0; i < markersDestino.length; i++) {
    map.removeLayer(markersDestino[i]);
  }
  markersDestino = [];
}
function refrescarMapa() {
  if (!window.map) return;

  setTimeout(function () {
    map.invalidateSize(true);
  }, 200);
}

function ensureMapReady() {
  const el = document.getElementById("map");
  if (!el) return;

  // asegurar que el contenedor tenga tamaño
  el.style.display = "block";
  el.style.minHeight = "280px";
  el.style.height = "280px";

  // init seguro
  initMap();

  // esperar a que el DOM pinte
  requestAnimationFrame(() => {
    setTimeout(() => {
      if (!window.map) return;

      map.invalidateSize(true);

      // aplicar centro pendiente si existe
      if (window._pendingMapCenter) {
        map.setView(window._pendingMapCenter, 15);
        window._lastMapCenter = window._pendingMapCenter;
        window._pendingMapCenter = null;
      }
    }, 200);
  });
}
function setUpPoint() {



  $("#sucursalDestino2")
    .off("change.mapDestino")
    .on("change.mapDestino", function () {

      if (!window.map) return;

      LimpiarMapa();

      const provCod = $("#provincia2").val();
      const codSuc = $("#sucursalDestino2 option:selected").attr("class");

      if (!provCod || !codSuc) return;

      $.post(la_url + "/getCoordenadas", {

        token: $("input[name='_token']").val(),
        codProv: provCod,
        codSuc: codSuc,
        tipo: "E",

      }, function (data) {









        if (!data || !data.length) return;

        data = data[0];

        // 🔹 Todas las sucursales de la provincia
        data.sucursales_provincia.forEach(s => {
          if (!s.latitud || !s.longitud) return;

          const marker = L.marker([s.latitud, s.longitud])
            .addTo(map)

            .bindPopup(`
  <span class="popup-title">${s.descripcion}</span>
  <div class="popup-address">${s.domicilio}</div>
  <div class="popup-hours">
    ${(s.horario || '').replace(/\s*\/\s*/g, '<br>')}
  </div>
`)
            .on("click", () => {
              $("#sucursalDestino2 option")
                .filter("." + s.codigoSucursal)
                .prop("selected", true);
            });

          markersDestino.push(marker);
        });

        // 🔹 Sucursal seleccionada
        const center = [data.position.lat, data.position.lng];

        map.flyTo(center, 15);

        const selectedMarker = L.marker(center)
          .addTo(map)
          .bindPopup(`
  <span class="popup-title">${data.datos_sucursal.descripcion}</span>
  <div class="popup-address">${data.datos_sucursal.domicilio}</div>
  <div class="popup-hours">
    ${(data.datos_sucursal.horario || '').replace(/\s*\/\s*/g, '<br>')}
  </div>
`)

          .openPopup();

        markersDestino.push(selectedMarker);
      });
    });


}

