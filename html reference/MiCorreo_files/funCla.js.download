function validarTelefonoNE($cod, $cel) {
  const dig = s => String(s || "").replace(/\D/g, "");

  const cod = dig($cod.val());
  const cel = dig($cel.val());

  const codLenOk = cod.length >= 2 && cod.length <= 4;
  const celLenOk = cel.length >= 6 && cel.length <= 8;
  const noCero = !cod.startsWith("0");
  //const no15 = !cel.startsWith("15");
  const totalOk = (cod.length + cel.length) === 10;

  const ok = codLenOk && celLenOk && noCero && totalOk;

  // Bordes
  $cod.toggleClass("border border-danger", !ok);
  $cel.toggleClass("border border-danger", !ok);

  return ok;
}


function validarCodAreaNE($cod) {

  const digits = s => String(s || "").replace(/\D/g, "");
  const cod = digits($cod.val());

  const ok = /^\d{2,4}$/.test(cod) && !cod.startsWith("0");

  $cod.toggleClass("border border-danger", !ok);
  return ok;
}

function validarCelularNE($cel, cod) {
  const digits = s => String(s || "").replace(/\D/g, "");
  const cel = digits($cel.val());
  const codDigits = digits(cod || "");

  const celLenOk = cel.length >= 6 && cel.length <= 8;
  const totalOk = (codDigits.length + cel.length) === 10;

  // regla del 15
  //const celStarts15 = cel.startsWith("15") && !totalOk;

  const ok = celLenOk;

  $cel.toggleClass("border border-danger", !ok);
  return ok;
}

function validarTelefonoCompat($cod, $cel) {
  const digits = s => String(s || "").replace(/\D/g, "");

  const cod = digits($cod.val());
  const cel = digits($cel.val());
  const codLen = cod.length;
  const celLen = cel.length;

  const codLenOk = codLen >= 2 && codLen <= 4;
  const celLenOk = celLen >= 6 && celLen <= 8;
  const totalOk = (codLen + celLen) === 10;
  const codStarts0 = cod.startsWith("0");
  const celStarts15 = cel.startsWith("15");

  const telOk = codLenOk && celLenOk && totalOk && !codStarts0 && !celStarts15;

  if (telOk) {
    $cod.removeClass("border border-danger");
    $cel.removeClass("border border-danger");
    return true;
  }

  $cod.addClass("border border-danger");
  $cel.addClass("border border-danger");
  return false;
}

function mostrarErroresNF3({ camposVacios, checkProducto, validacionMail, telOk }) {
  limpiarNF3();

  const lines = [];

  if (!camposVacios || !checkProducto)
    lines.push("* Campo obligatorio");

  if (!validacionMail)
    lines.push("* El email debe ser válido");

  if (!telOk)
    lines.push("* Ingresá 10 dígitos entre código de área (2 a 4 dígitos) sin 0 y número de celular (6 a 8 dígitos) sin 15.");

  mostrarNF3(lines.join("<br>"));
}


function validarMailNE(obj) {
  var mail = myTrim(obj.val());
  if (mail == "" || typeof mail == "undefined") {
    return false;
  }
  var emailReg = /^([\w-\.]+@([\w-]+\.)+[\w-]{2,4})?$/;
  var validacionMail = emailReg.test(mail);
  if (validacionMail) {
    obj.removeClass("border border-danger");
    return true;
  } else {
    obj.addClass("border border-danger");

    return false;
  }
}
