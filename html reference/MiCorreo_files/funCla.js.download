            $("#cpCpa").val(modEnvioData["destino_cp"]);

            // activate change
            $("#provincia").change();
          }
        }
        //$('#flagCla').val('n');
        $("#estDD").val("1");

        //-- control del nivelador
        $("#nivelador").removeClass("pb-5");
        return true;
      } else {
        if (valCamposNEO($("#medidasPaquete"))) {
          if (medidaValida($("#peso"), $("#pesoMaximoPermitido"))) {
            $("#peso").removeClass("border border-danger");
          }
          //$('#peso').removeClass('border border-danger');
          $("#valorContenido").removeClass("border border-danger");
