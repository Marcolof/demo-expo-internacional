                              // Realizar la solicitud a /cotizarNE con los valores definidos
                              $.post(la_url + "/cotizarNE", {
                                token: $("input[name='_token']").val(),
                                idCliente: $("#idCliente").val(),
                                codSapClasico: matSapClasico,
                                codSapExpreso: matSapExpreso,
                                codSapHoy: matSapHoy,
                              }).then(function (data) {
                                if (typeof data === 'string' && data.startsWith("Error")) {
                                  console.log("Se produjo un error:", data);
                                  $("#CLASICO").removeClass("text-primary").text("");
                                  // .addClass("text-danger");
                                  $("#pqClasic").attr("disabled", "disabled");
