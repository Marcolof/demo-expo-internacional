function applyMsgStyle() {
  const css = `
#mensajespaqueteria, #mensajespaqueteria* {
  color: #191919 !important;
  font-size: 16px !important;
  line-height: 1.25 !important;
  font-weight: 400 !important;
  text-decoration: none !important;
}
#mensajespaqueteria small {
  display: block;
  margin-top: .25rem;
}

/* Fondo único para los mensajes de error */
.error-msg {
  background-color: #FFD0D0;  /* rojo claro */
  color: #d32f2f;             /* rojo oscuro */
  border: 1px solid #FFD0D0;
  border-radius: 6px;
  padding: 8px 12px;
  margin: 6px 0;
  font-size: 14px;
  line-height: 1.2;
  display: block;
}
`;
  const node = document.getElementById("msgStyle16");
  if (node) node.textContent = css;
  else $("<style id='msgStyle16'>").text(css).appendTo(document.head);
}

function validarCamposCompletosDom() {
  const v = sel => String($(sel).val() || "").trim();

  applyMsgStyle();

  const allOk =
    v("#nars") !== "" &&
    $("#provincia").val() !== "-1" &&
    v("#localidad") !== "" &&
    v("#direCompleta") !== "" &&
    v("#cpCpa") !== "" &&
    v("#correoElectronico") !== "" &&
    $("#producTi").val() !== "-1";

  $("#pagar")
    .prop("disabled", !allOk)
    .toggleClass("btn-pagar", allOk)
    .toggleClass("btn-pagar-d", !allOk);

  return allOk;
}



