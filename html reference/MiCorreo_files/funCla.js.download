function controlHabilitarPago() {
  //$('#eDestino').on('');
  /*$('#eDestino :input').on('input', function () {
        
    });*/
  $("input[name='tipoProduc']").on("click", function () {
    // console.log("MAPPPPAAAAA 11")

    if ($("#estadoControlDestino").val() == "domicilio") {
      if (
        valCamposNE($("#tipoEntrega")) &&
        valCamposNE($("#cpCpa")) &&
        valCamposNE($("#nars")) &&
        valCamposNE($("#correoElectronico")) &&
        valCamposNE($("#provincia")) &&
        valCamposNE($("#celularPaqDom")) &&
        valCamposNE($("#localidad")) &&
        valCamposNE($("#direCompleta"))
      ) {
        $("#pagar")
          .removeAttr("disabled")
          .removeClass("btn-pagar-d")
          .addClass("btn-pagar");
      }
    } else if ($("#estadoControlDestino").val() == "sucursal") {
      if (
        valCamposNE($("#tipoEntrega")) &&
        valCamposNE($("#nars2")) &&
        valCamposNE($("#provincia2")) &&
        valCamposNE($("#sucursalDestino2")) &&
        valCamposNE($("#correoElectronico2")) &&
        valCamposNE($("#celularPaqSuc"))
      ) {
        $("#pagar")
          .removeAttr("disabled")
          .removeClass("btn-pagar-d")
          .addClass("btn-pagar");
      }
    }
  });
  /*
    $('#columnas_excel').find('input, select, button').each(function() {
                                            })
                                            */
}

function tipoProducto(codp) {
  $.get(la_url + "/tipoProducto/" + $("#cp_origen").val() + "/" + $(codp).val(),
    function (data) {
      //var res = JSON.parse(data);
      return data;
    }
  );
}

function volver() {
  $("#prev").on("click", function () {
    $("#next").text("Siguiente");
    $("#prev").addClass("d-none");
    $("#medi").val("-");
    $("#mediL").text("-");
    $("#pesoTotal").val("-");
    $("#pesoTotalL").text("-");
    $("#valor").val("-");
    $("#valorL").text("-");
    $("#eDestino").addClass("d-none");
    $("#medidasPaquete").removeClass("d-none");
    $("#condi").addClass("d-none");
    $("#estadoControl").val("1");
    $("#pagar").attr("disabled", "disabled")
      .removeClass("btn-pagar")
      .addClass("btn-pagar-d");
    $("#tipoProduc").addClass("d-none");
    $("#nf_maximo_medidas").addClass("d-none");
    $("#nf_resumen_faltante").addClass("d-none");
  });
}

function valCamposNE(obj) {
  if ($(obj).val() == "" || $(obj).val() == "-1") {
    $(obj).addClass("border border-danger");
    return false;
  }
  return true;
}

//--  funcion para validar los campos obligatorios
//-- REQUIERE: contendor == (id del div que contiene al set de datos)
function valCamposNEO(contendor) {
  var c = 0;
  $(contendor)
    .find("input, select")
    .each(function () {
      if (
        !$(this).parent().hasClass("d-none") &&
        // $(this).attr("name") != 'celular2' &&
        // $(this).attr("name") != 'celular' &&
        ($(this).val() == "-1" || $(this).val() == "") &&
        $(this).prop("required")
      ) {

        $(this).addClass("border border-danger");
        console.log($(this).attr("name") + " - " + $(this).val());
        c += 1;
      }
    });
  return c === 0;
}

function resetAll(contendor) {
  $(contendor)
    .find("input")
    .each(function () {
      if (!$(this).parent().hasClass("d-none") && $(this).val() != "") {
        $(this).value = "";
      }
    });
  $(contendor)
    .find("select")
    .each(function () {
      if (!$(this).parent().hasClass("d-none") && $(this).val() != "-1") {
        $(this).selectedIndex = 0;
      }
    });
}

function valCamposNEB(obj) {
  if ($(obj).val() == "" || $(obj).val() == "-1") {
    return false;
  }
  return true;
}

function removeBD(obj) {
  $(obj).on("input", function () {
    $(this).removeClass("border border-danger");
    //$('#nf1').addClass('d-none');
    //$('#nf3').addClass('d-none');
  });
}

function removeBD2(obj) {
  $(obj).on("input", function () {
    $(this).removeClass("border border-danger");
    //$('#nf2').addClass('d-none');
    $("#nf3").addClass("d-none");
  });
}

function selectMF() {
  //alert($('#medidasFrecuentes').val());
  var e = $("#medidasFrecuentes").val();
  $("#largo").val($("#" + e + " > .mLA").val());
  $("#alto").val($("#" + e + " > .mAL").val());
  $("#ancho").val($("#" + e + " > .mAN").val());

  $("#medidasFrecuentes").on("change", function () {
    var i = $(this).val();
    //alert($("#" + i + " > .mLA").val());
    $("#largo").val($("#" + i + " > .mLA").val());
    $("#alto").val($("#" + i + " > .mAL").val());
    $("#ancho").val($("#" + i + " > .mAN").val());
  });
}

function controlMF() {
  $("#guardarMedidasF").on("click", function (e) {
    e.preventDefault();
    if ($("#medidasFrecuentes").val() == "-1") {
      $("#exampleModal").modal("toggle");
    }
  });
}
function formModalGuardarMedidasFrecuentes() {
  $("#btFormModalMF").on("click", function () {
    var r = $("#recordar").is(":checked");
    r = r ? "y" : "n";

    var mensaje = "";

    var alto = parseInt($('#alto').val());
    var ancho = parseInt($('#ancho').val());
    var largo = parseInt($("#largo").val());

    var max_alto = Number($("#maximo_altura").val());
    var max_ancho = Number($("#maximo_ancho").val());
    var max_largo = Number($("#maximo_largo").val());

    if (isNaN(alto) || alto > max_alto || alto <= 0) {
      mensaje += "* La altura no puede ser mayor a " + max_alto + "cm ni menor a 1cm<br>";
    }
    if (isNaN(ancho) || ancho > max_ancho || ancho <= 0) {
      mensaje += "* El ancho no puede ser mayor a " + max_ancho + "cm ni menor a 1cm<br>";
    }
    if (isNaN(largo) || largo > max_largo || largo <= 0) {
      mensaje += "* El largo no puede ser mayor a " + max_largo + "cm ni menor a 1cm<br>";
    }
    // console.log(parseInt(MAXIMO_PERMITIDO_ALTURA_ENVIO)+ parseInt(MAXIMO_PERMITIDO_ANCHO_ENVIO) + parseInt(MAXIMO_PERMITIDO_LARGO_ENVIO));

    if ((largo + ancho + alto) > Number($("#maximo_laa").val())) {
      mensaje += "* La suma del Alto x Largo x Ancho no puede ser superior a " + Number($("#maximo_laa").val()) + "cm<br>";
    }


    if (mensaje == "") {
      console.log('valido dimensiones');

      if ($("#aliasMedidas").val() != "") {
        $.post(la_url + "/guardarMedidasFrecuentes", {
          token: $("input[name='_token']").val(),
          uid: $("#uid").val(),
          recordar: r,
          largo: $("#largo").val(),
          alto: $("#alto").val(),
          ancho: $("#ancho").val(),
          aliasMedidas: $("#aliasMedidas").val(),
        }, function (response) {
          console.log("Respuesta del servidor: " + response);
          //hago peticion para actualizar el select medidas


        }).fail(function () {
          console.log("Error al realizar la solicitud");

        });
        $('#nf_maximo_medidas').addClass('d-none');
        $("#exampleModal").modal("toggle");
        $("#medidasFrecuentes").val("-2");

      } else {
        $("#aliasMedidas").addClass('border border-danger');
        $("#mensajeError")
          .removeClass("d-none")
          .addClass("error-msg")
          .html("* Campo obligatorio");
      }

    } else {
      $('#nf_maximo_medidas').removeClass('d-none');
      $('#nf_maximo_medidas').html(mensaje);

      $("#exampleModal").modal("toggle");
      $("#medidasFrecuentes").val("-2");
    }


  });
}

function tipoEntregaSelect() {
  $("#tipoEntrega").on("change", function () {
  $("#verifi-cpO-cp").addClass("d-none");
    if ($(this).val() == "-1") {
      $("[id$=D]").addClass("d-none");
      $("[id$=D2]").addClass("d-none");
      $("[id$=D2] select").each(function () {
        this.selectedIndex = 0;
      });
      $("[id$=D2] input[type=text], input[type=email]").each(function () {
        this.value = "";
      });
      $("[id$=D] select").each(function () {
        this.selectedIndex = 0;
      });
      $("[id$=D] input[type=text], input[type=email], textarea").each(
        function () {
          this.value = "";
        }
      );
      $("#tipoProduc").addClass("d-none");
      $("#estadoControlDestino").val("0");
      //-- nivelador
      $("#nivelador").removeClass("pb-5");
    } else if ($(this).val() == "domicilio") {
      $('#camposEntregaDomicilio').css('top', '-40px');
      $("[id$=D2]").addClass("d-none");
      $("[id$=D]").removeClass("d-none");
      $("[id$=D2] select").each(function () {
        this.selectedIndex = 0;
      });
      $("[id$=D2] input[type=text], input[type=email]").each(function () {
        this.value = "";
      });
      // console.log("MAPAAAAAAAAAAA 111")
      $("#tipoProduc").removeClass("d-none");
      $("#estadoControlDestino").val("domicilio");
      //-- nivelador
      $("#nivelador").addClass("pb-5");
    } else {
      $('#camposEntregaDomicilio').css('top', '0px');
      $("[id$=D2]").removeClass("d-none");
      $("[id$=D]").addClass("d-none");
      $("[id$=D] select").each(function () {
        this.selectedIndex = 0;
      });
      $("[id$=D] input[type=text], input[type=email], textarea").each(
        function () {
          this.value = "";
        }
      );
      // console.log("MAPAAAAAAAAAAA 111")

      $("#tipoProduc").removeClass("d-none");
      $("#estadoControlDestino").val("sucursal");
      if (document.querySelector('#map') && document.querySelector('#map').children.length === 0) { initMap(); }
      //-- nivelador
      $("#nivelador").addClass("pb-5");
    }
    if ($("input[name='tipoProduc']").is(":checked")) {
      $("input[name='tipoProduc']").prop("checked", false);
      $("#producTi").val("-1");
      $("#tipo_producto").val("");
    }
  });
}

function controlDestino() {
  $("#checkPickUp").on("click", function () {
    $("#direccionOrigen").removeClass("d-none");
    $("#selectSucursalProvOrigen").addClass("d-none");
    $("#selectSucursalOrigen").addClass("d-none");
    $("#recordarSucursal").addClass("d-none");//testeo el chek sucursal
    $("#columnaMapCorreo").addClass("d-none");
    $("#sucursalProvinciaOrigen").prop("selectedIndex", 0);
    $("#sucursalOrigen").prop("selectedIndex", 0);
  });
  $("#checkSucursal").on("click", function () {
    $("#direccionOrigen").addClass("d-none");
    $("#selectSucursalProvOrigen").removeClass("d-none");
    $("#selectSucursalOrigen").removeClass("d-none");//testeo el chek sucursal
    $("#recordarSucursal").removeClass("d-none");
    $("#columnaMapCorreo").removeClass("d-none");
    $("#dirOrigen").prop("selectedIndex", 0);

    // if (!document.querySelector("#mapSuc").children.length > 0) {
    //   initMapSucOrigen();
    // }
    if ((existeSucursalCabecera && ($('#input_origen_sucursal').val() == null) || (existeSucursalCabecera && (test['codigoSucursal']) == $('#input_origen_sucursal').val()))) {
      $('#sucursalProvinciaOrigen option[value="' + provinciaCabecera + '"]').prop('selected', true);
      $("#selectSucursalProvOrigen").change();
      $('#sucursalOrigen option[value="' + test['codigoSucursal'] + '"]').prop('selected', true);
    }
    if (isEditing && (modEnvioData['origen_sucursal'] != null && modEnvioData['origen_sucursal'] != "")) {
      $("#sucursalProvinciaOrigen").val(modEnvioData["origen_provincia"]);
      $("#selectSucursalProvOrigen").change();
      $("#sucursalOrigen").val(modEnvioData['origen_sucursal']);
    }
    if (!document.querySelector("#mapSuc").children.length > 0) {
      initMapSucOrigen();
    }
    if ((isEditing && (modEnvioData['origen_sucursal'] != null && modEnvioData['origen_sucursal'] != "")) || ($('#input_origen_sucursal').val() != null && existeSucursalCabecera && (test['codigoSucursal']) == $('#input_origen_sucursal').val()))
      $("#sucursalOrigen").change();
  });
}

