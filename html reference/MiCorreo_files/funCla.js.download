                              // .addClass("text-danger");
                              $("#pqHoy").attr("disabled", "disabled");
                              if ($("#pqHoy").is(":checked")) {
                                $("#pqHoy").prop("checked", false);
                                $("#producTi").val("-1");
                                $("#tipo_producto").val("");
