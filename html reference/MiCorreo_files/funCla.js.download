    $("#checkPickUp").removeAttr("checked").attr("disabled", "disabled");

  }
}
function FormatearNumero(numeroFormatear) {
  var numero = numeroFormatear;

  // Dividir el número en parte entera y decimal
  var partes = numero.split(".");
  var parteEntera = partes[0];
  var parteDecimal = partes[1];

  // Formatear la parte entera añadiendo puntos cada tres dígitos desde la derecha
  parteEntera = parteEntera.replace(/\B(?=(\d{3})+(?!\d))/g, ".");

  // Unir la parte entera y la parte decimal con una coma
  var numeroFormateado = parteEntera + "," + parteDecimal;
  return numeroFormateado;
}
function llamadaVCP(provincia, codp) {
  $("#verifi-cpO-cp").addClass("d-none");
  $("#cpCpa").removeClass("border border-danger");
  $("#provincia").removeClass("border border-danger");
  $.ajax({
    type: "POST",
    url: la_url + "/checkSesion",
    data: {
      token: $("input[name='_token']").val(),
    },
    headers: {
      "x-csrf-token": $("input[name='_token']").val(),
    },
    success: function (respuesta) {
      if (respuesta != 1) {
        window.location.href = "sesion-expirada";
      } else {
        $.post(la_url + "/checkcp",
          {
            token: $("input[name='_token']").val(),
            prov: $(provincia).val(),
            cp: $(codp).val(),
          },
          function (data) {
            var res = JSON.parse(data);
            if (res.error != "0") {
              //alert(res.msg);
              $("#verifi-cpO-cp").removeClass("d-none");
              alertPer(provincia, codp);
              $("input[name='tipoProduc']").attr("disabled", "disabled");
              $("#HOY").addClass("d-none");
              $("#EXPRESO").addClass("d-none");
              $("#CLASICO").addClass("d-none");
              if ($("input[name='tipoProduc']").is(":checked")) {
                $("input[name='tipoProduc']").prop("checked", false);
                $("#producTi").val("-1");
                $("#tipo_producto").val("");
              }
            } else {
              $("#CP").val("0");
              $("#EP").val("0");
              $("#UP").val("0");
              var tp = [
                "PAQ.AR EXPRESO",
                "PAQ.AR CLASICO",
                "PAQAR HOY",
                "PAQ.AR HOY",
              ];
              //let tpCP = [];
              if (controlMesajeErrorResumen()) {
                $.get(la_url + "/tipoProducto/" + $("#cp_origen").val() + "/" + $(codp).val(),
                  function (data2) {
                    //console.log(data2);
                    $("#cod-sap").val(data2.nroClienteSap);
                    for (var e = 0; e < tp.length; e++) {
                      $.each(data2.tproductos, function (i, item) {

                        if (data2.tproductos[i].descripcionProd === tp[e]) {
                          var n = tp[e].split(" ")[1];
                          $("." + n).removeAttr("disabled");
                          if ($("#check_pickup").val() == 'no' && n == "HOY") {
                            $("." + n).attr("disabled", true);
                          }
                        }
                        /*if ((data2.tproductos[i].codigoProducto === 'CP' || data2.tproductos[i].codigoProducto === 'EP') && tpCP.includes(data2.tproductos[i].codigoProducto) === false) {
                                      tpCP.push(data2.tproductos[i].codigoProducto);
                                  }*/
                        if (data2.tproductos[i].codigoProducto === "CP") {
                          $("#CP").val("1");
                        }
                        if (data2.tproductos[i].codigoProducto === "EP") {
                          $("#EP").val("1");
                        }
                        if (data2.tproductos[i].codigoProducto === "UP" && $("#check_pickup").val() == 'si') {
                          $("#UP").val("1");
                        }
                      });
                    }
                    // var matSap;
                    // var matSap0;
                    // var matSapH;
                    $.post(la_url + "/consultaActivado",
                      { token: $("input[name='_token']").val() },
                      function (data3) {

                        //console.log(JSON.parse(data3));
                        if (JSON.parse(data3).verificar == "1") {
                          var tipoEntrga = $("#tipoEntrega").val();
