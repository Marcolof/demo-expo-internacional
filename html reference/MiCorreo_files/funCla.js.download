                              eAncho: eAncho,
                              eAlto: eAlto,
                              ePeso: ePeso,
                              eValor: eValor,
                            }), // Hacer la solicitud para CP
                            $.post(la_url + "/valNEpreimpo", {
                              token: $("input[name='_token']").val(),
                              idCliente: $("#idCliente").val(),
                              codSap: $("#cod-sap").val(),
                              tipoEntrga: tipoEntrga,
                              rsO: $("#narz").val(),
                              codProvR: $("#codigoProO").val(),
                              cpD: $(codp).val(),
                              cpO: $("#cp_origen").val(),
                              codProvD: $(provincia).val(),
