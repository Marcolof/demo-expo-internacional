function obtenerTipoProducto() {
  $("input[name='tipoProduc']").on("click", function () {
    $("#tipo_producto").val($(this).val());
  });
}

function disableTipoProducto() {
  $("#tipoEntrega").on("change", function () {
    $("input[name='tipoProduc']").attr("disabled", "disabled");
    $("#EXPRESO").addClass("d-none");
    $("#CLASICO").addClass("d-none");
    $("#HOY").addClass("d-none");
    $("#CP").val("0");
    $("#EP").val("0");
    $("#UP").val("0");
  });
}

function habilitarCondicion() {
  $("#tipoEntrega").on("change", function () {
    if ($(this).val() != "-1") {
      $("#condi").removeClass("d-none");
    } else {
      $("#condi").addClass("d-none");
    }
  });
}

function alertPer(provincia, codp) {
  $(provincia).addClass("border border-danger");
  $(codp).addClass("border border-danger");
}

function delPer(provincia, codp) {
  $(provincia).on("change", function () {
    if ($(codp).val() != "") {
      $(provincia).removeClass("border border-danger");
      $(codp).removeClass("border border-danger");
    }
  });
  $(codp).on("input", function () {
    $(provincia).removeClass("border border-danger");
    $(codp).removeClass("border border-danger");
  });
}
