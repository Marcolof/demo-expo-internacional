                              eAncho: eAncho,
                              eAlto: eAlto,
                              ePeso: ePeso,
                              eValor: eValor,
                            }), // Hacer la solicitud para EP
                            $.post(la_url + "/valNEpreimpo", {
                              token: $("input[name='_token']").val(),
                              idCliente: $("#idCliente").val(),
                              codSap: $("#cod-sap").val(),
