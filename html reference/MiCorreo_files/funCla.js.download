                                  // .addClass("text-danger");
                                  $("#pqExpress").attr("disabled", "disabled");
                                  if ($("#pqExpress").is(":checked")) {
                                    $("#pqExpress").prop("checked", false);
                                    $("#producTi").val("-1");
                                    $("#tipo_producto").val("");
                                  }
                                  $("#HOY").removeClass("text-primary").text("");
                                  // .addClass("text-danger");
                                  $("#pqHoy").attr("disabled", "disabled");
                                  if ($("#pqHoy").is(":checked")) {
                                    $("#pqHoy").prop("checked", false);
                                    $("#producTi").val("-1");
                                    $("#tipo_producto").val("");
                                  }
                                } else {
                                  var d = JSON.parse(data);
                                  var precioTotalClasico,
                                    precioTotalExpreso,
                                    precioTotalHoy;
                                  console.log("Respuesta de cotizar CAMBIO", d);
                                  if (matSapClasico && !matSapExpreso && !matSapHoy) {
                                    console.log("OK, undefined, undefined");
                                    precioTotalClasico =
                                      d.entity.listaDeEnviosAPreimponer[0].precioTotal;
                                  }
                                  if (matSapClasico && matSapExpreso && !matSapHoy) {
                                    console.log("OK, OK, undefined");
                                    precioTotalClasico =
                                      d.entity.listaDeEnviosAPreimponer[0].precioTotal;
                                    precioTotalExpreso =
                                      d.entity.listaDeEnviosAPreimponer[1].precioTotal;
                                  }
                                  if (matSapClasico && !matSapExpreso && matSapHoy) {
                                    console.log("OK, undefined, OK");
                                    precioTotalClasico =
                                      d.entity.listaDeEnviosAPreimponer[0].precioTotal;
                                    precioTotalHoy =
                                      d.entity.listaDeEnviosAPreimponer[1].precioTotal;
                                  }
                                  if (!matSapClasico && !matSapExpreso && matSapHoy) {
                                    console.log("undefined, undefined, OK");
                                    precioTotalHoy =
                                      d.entity.listaDeEnviosAPreimponer[0].precioTotal;
                                  }
                                  if (!matSapClasico && matSapExpreso && matSapHoy) {
                                    console.log("undefined, OK, OK");
                                    precioTotalExpreso =
                                      d.entity.listaDeEnviosAPreimponer[0].precioTotal;
                                    precioTotalHoy =
                                      d.entity.listaDeEnviosAPreimponer[1].precioTotal;
                                  }
                                  if (!matSapClasico && matSapExpreso && !matSapHoy) {
                                    console.log("undefined, OK, undefined");
                                    precioTotalExpreso =
                                      d.entity.listaDeEnviosAPreimponer[0].precioTotal;
                                  }
                                  if (matSapClasico && matSapExpreso && matSapHoy) {
                                    console.log("OK, OK, OK");
                                    precioTotalClasico =
                                      d.entity.listaDeEnviosAPreimponer[0].precioTotal;
                                    precioTotalExpreso =
                                      d.entity.listaDeEnviosAPreimponer[1].precioTotal;
                                    precioTotalHoy =
                                      d.entity.listaDeEnviosAPreimponer[2].precioTotal;
                                  }
                                  if (precioTotalClasico) {
                                    $("#CLASICO")
                                      .removeClass("text-primary text-danger")
                                      .text(
                                        " $ " + FormatearNumero(precioTotalClasico)
                                      );
                                    console.log("precio Clásico: ", precioTotalClasico);
                                  } else {
                                    $("#CLASICO").removeClass("text-primary").text("");
                                    // .addClass("text-danger");
                                    $("#pqClasic").attr("disabled", "disabled");
                                    if ($("#pqClasic").is(":checked")) {
                                      $("#pqClasic").prop("checked", false);
                                      $("#producTi").val("-1");
                                      $("#tipo_producto").val("");
                                    }
                                  }
                                  if (precioTotalExpreso) {
                                    $("#EXPRESO")
                                      .removeClass("text-primary text-danger")
                                      .text(
                                        " $ " + FormatearNumero(precioTotalExpreso)
                                      );
                                    console.log("precio Expreso: ", precioTotalExpreso);
                                  } else {
                                    $("#EXPRESO").removeClass("text-primary").text("");
                                    // .addClass("text-danger");
                                    $("#pqExpress").attr("disabled", "disabled");
                                    if ($("#pqExpress").is(":checked")) {
                                      $("#pqExpress").prop("checked", false);
                                      $("#producTi").val("-1");
                                      $("#tipo_producto").val("");
                                    }
                                  }
                                  if (precioTotalHoy) {
                                    $("#HOY")
                                      .removeClass("text-primary text-danger")
                                      .text(
                                        " $ " + FormatearNumero(precioTotalHoy)
                                      );
                                    console.log("precio Hoy: ", precioTotalHoy);
                                  } else {
                                    $("#HOY").removeClass("text-primary").text("");
                                    // .addClass("text-danger");
                                    $("#pqHoy").attr("disabled", "disabled");
                                    if ($("#pqHoy").is(":checked")) {
                                      $("#pqHoy").prop("checked", false);
                                      $("#producTi").val("-1");
                                      $("#tipo_producto").val("");
                                    }
                                  }
                                }
                              });
                            } else {
                              console.log("Ningún valor de matSAP válido, no se puede realizar el post.");
                              $("#CLASICO").removeClass("text-primary").text("");
                              // .addClass("text-danger");
                              $("#pqClasic").attr("disabled", "disabled");
                              if ($("#pqClasic").is(":checked")) {
                                $("#pqClasic").prop("checked", false);
                                $("#producTi").val("-1");
                                $("#tipo_producto").val("");
                              }
                              $("#EXPRESO").removeClass("text-primary").text("");
                              // .addClass("text-danger");
                              $("#pqExpress").attr("disabled", "disabled");
                              if ($("#pqExpress").is(":checked")) {
                                $("#pqExpress").prop("checked", false);
                                $("#producTi").val("-1");
                                $("#tipo_producto").val("");
