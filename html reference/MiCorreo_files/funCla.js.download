// --- limpia #mensajeError ---
function limpiarMensajeError() {
  const $msg = $("#mensajeError");
  if ($msg.length) {
    $msg.stop(true, true)
      .empty()
      .addClass("d-none")
      .removeClass("error-msg text-danger show is-invalid");
  }
}

function limpiarMensajesPaqueteria() {
  const $msg = $("#mensajespaqueteria");
  if ($msg.length) {
    $msg.stop(true, true).empty().addClass("d-none").removeClass("error-msg text-danger show");
  }
  $("#codAreaPaqDom, #celularPaqDom, #codAreaPaqSuc, #celularPaqSuc").removeClass("border border-danger is-invalid");
  $("#pagar").prop("disabled", true).removeClass("btn-pagar").addClass("btn-pagar-d");
}

function mostrarMensajeError(texto) {
  let $box = $("#mensajeError");
  if (!$box.length) {
    $box = $('<div id="mensajeError" class="d-none"></div>').appendTo("body");
  }
  $box.stop(true, true)
    .removeClass("d-none")
    .addClass("error-msg")
    .html(texto);
}

function mostrarNF3(texto) {
  let $box = $("#nf3");
  if (!$box.length) {
    $box = $('<div id="nf3" class="d-none" aria-live="polite"></div>').appendTo("body");
  }

  const hayMensaje = texto && texto.trim() !== "";

  if (hayMensaje) {
    $box
      .stop(true, true)
      .removeClass("d-none")
      .addClass("error-msg")
      .html(texto);
  } else {
    $box
      .stop(true, true)
      .empty()
      .addClass("d-none")
      .removeClass("error-msg");
  }
}

function limpiarNF3() {
  $("#nf3")
    .stop(true, true)
    .empty()
    .addClass("d-none")
    .removeClass("error-msg"); // 🔥 clave
}

