    }
    if (!destino) {
      // cambiarClass("#liproducto", "data", "nodata");
      cambiarClass("#iconop3", "bi-circle-fill", "bi-circle");
      $("#lidestino").addClass("visited");
    } else {
      // $("#liproducto").removeClass("nodata");
      // cambiarClass("#iconop3", "falta", "");
    }

    $("#panel1, #panel3").removeClass("active show");
    $("#etiqueta-datosdel").html("Destino");
    $("#envio-destino-nombre").focus();
  } else if (target == "#panel3") {
    $("#producto").removeClass("botontab-estadoinicial");
    // $('#ulenvios').css('background-position-y','-66px');
    cambiarClass("#envio", "botontab", "botontabsel");
    cambiarClass("#destino", "botontab", "botontabsel");
    cambiarClass("#producto", "botontab", "botontabsel");
    if (!dire) {
      console.log("dire:", dire);
      cambiarClass("#iconop1", "bi-circle-fill", "bi-circle");
    } else {
      // $("#lienvio").removeClass("nodata");
      cambiarClass("#iconop1", "bi-circle", "bi-circle-fill");
    }
    if (!medi || !pesoTotal || !valor) {
      cambiarClass("#iconop2", "bi-circle-fill", "bi-circle");
    } else {
      // $("#lidestino").removeClass("nodata");
      cambiarClass("#iconop2", "bi-circle", "bi-circle-fill");
    }
    cambiarClass("#iconop3", "falta", "");
    $("#panel1, #panel2").removeClass("active show");
    $("#etiqueta-datosdel").html("Paquete");
    $("#tipo_producto").focus();
  } else if (target == "#panel1") {
    // $('#ulenvios').css('background-position-y','0px');
    cambiarClass("#envio", "botontab", "botontabsel");
    cambiarClass("#destino", "botontabsel", "botontab");
    cambiarClass("#producto", "botontabsel", "botontab");
    if (!destino) {
      cambiarClass("#iconop3", "bi-circle-fill", "bi-circle");
    } else {
      // $("#liproducto").removeClass("nodata");
      cambiarClass("#iconop3", "bi-circle", "bi-circle-fill");
    }
    if (medi || pesoTotal || valor) {
      // $("#lidestino").removeClass("nodata");
      $("#lidestino").addClass("visited");
      $("#lienvio").addClass("visited");
      $("#iconop2").removeClass("falta");
      cambiarClass("#iconop2", "bi-circle", "bi-circle-fill");
      console.log("tengo datos en el punto 2");
    } else if (!medi || !pesoTotal || !valor) {
      cambiarClass("#iconop2", "bi-circle-fill", "bi-circle");
      $("#lidestino").addClass("visited");
      $("#lienvio").addClass("visited");
      $("#iconop2").addClass("falta");
    }

    $("#panel2, #panel3").removeClass("active show");
    $("#etiqueta-datosdel").html("Origen");
    $("#envio-origen-provincia").focus();
  }
}

function toggleResumen() {
  var resumenMobile = document.getElementById('resumenMobile');
  var toggleButton = document.getElementById('verResumen');
  resumenMobile.classList.toggle('mostrar');

  // Cambiar el texto del botón según el estado del resumen
  if (resumenMobile.classList.contains('mostrar')) {
    toggleButton.textContent = '- Resumen';
  } else {
    toggleButton.textContent = '+ Resumen';
  }
}

function enviarRecordarSucursal() {
  // Obtener el valor del input
  var checkbox = document.getElementById("recordarSucursalCheckBox");
  var divRecordarSucursal = document.getElementById("recordarSucursal");

  // console.log($('#tieneSucursalCabecera').val());
  // console.log(test1);

  //test1 dice si tiene pickup == 1, si no tiene es == false
  if ((checkbox.checked && !divRecordarSucursal.classList.contains("d-none")) || ((test1 == false || test1 == '0') && $('#tieneSucursalCabecera').val() == '')) {

    var nuevaSucursal = document.getElementById("sucursalOrigen");
    var nuevaSucursalVal = nuevaSucursal.value;
    console.log("nuevaSucursalVal: " + nuevaSucursalVal);
    var dato = $("#miInput").val();

    // Obtener el token CSRF del metaetiqueta
    var token = $('meta[name="csrf-token"]').attr('content');

    // Realizar la solicitud AJAX con el token CSRF
    $.ajax({
      type: "POST",
      url: la_url + "/actualizaSucursalCabecera",
      data: {
        token: $("input[name='_token']").val(),
        nuevaSucursal: nuevaSucursalVal
        // id_envio: $("#id_envios").val(),
      },
      headers: {
        "x-csrf-token": $("input[name='_token']").val(),
      },
      success: function (respuesta) {
        provinciaCabecera = $("#sucursalProvinciaOrigen").val();
        test['codigoSucursal'] = nuevaSucursalVal;
        // console.log("Respuesta del servidor:", respuesta);
      },
      error: function (error) {
        console.error("Error en la solicitud AJAX:", error);
        console.log(error.responseJSON.error)
        if (error.responseJSON.error === 'Unauthenticated.') {
          console.log("test ok")
          window.location.href = "sesion-expirada";
        }
      }
    });
  }
  else {
    //console.log("no se mando su")
    $.ajax({
      type: "POST",
      url: la_url + "/checkSesion",
      data: {
        token: $("input[name='_token']").val(),
      },
      headers: {
        "x-csrf-token": $("input[name='_token']").val(),
      },
      success: function (respuesta) {
        if (respuesta != 1) {
          window.location.href = "sesion-expirada";
        }
      },
      error: function (error) {
        window.location.href = "sesion-expirada";
      }
    });
  }
}

// === Robust init when editing/modifying an envío =============================
function ensureMapOnEdit(opts) {
  try {
    var el = document.getElementById('map');
    if (!el) return;
    // Ensure container height (Leaflet needs explicit height)
    if (!el.style.height || parseInt(getComputedStyle(el).height, 10) < 200) {
      el.style.minHeight = '280px';
      el.style.height = '280px';
    }
    // Init if empty
    if (el.children.length === 0) {
      initMap();
    }
    // Invalidate size after container becomes visible
    setTimeout(function () {
      if (window.map && typeof map.invalidateSize === 'function') {
        map.invalidateSize();
      }
      if (opts && opts.lat && opts.lng && window.L && window.map) {
        map.setView([opts.lat, opts.lng], 15);
      }
    }, 150);
  } catch (e) { if (window.console) console.warn('ensureMapOnEdit error', e); }
}

// === Limpieza al volver atrás ===
window.addEventListener("pageshow", function (event) {
  if (event.persisted || performance.getEntriesByType("navigation")[0].type === "back_forward") {
    $("#mensajesfullfillment, #mensajespaqueteria")
      .addClass("d-none")
      .empty()
      .removeClass("error-msg");
    $("#codAreaPaqDom, #celularPaqDom, #codAreaPaqSuc, #celularPaqSuc")
      .removeClass("border border-danger is-invalid");
  }
});

// === valorContenido: permitir pegar solo números y limpiar autofill ===

// 1) Permitir pegar SOLO si es numérico
$(document).on("paste", "#valorContenido", function (e) {
  let texto = (e.originalEvent || e).clipboardData.getData("text");

  if (!/^\d+$/.test(texto)) {
    e.preventDefault(); // bloquea pegar letras/símbolos
    return;
  }
});

// 2) Limpiar lo que venga del teclado, pegado válido o autocompletado
$(document).on("input change", "#valorContenido", function () {
  const el = this;

  setTimeout(() => {
    el.value = el.value.replace(/\D/g, "");
  }, 0);
});
function ensureMapReady() {
  const el = document.getElementById("map");
  if (!el) return;

  el.style.minHeight = "280px";
  el.style.height = "280px";

  if (!window.map) {
    initMap();
    setUpPoint();
  }

  setTimeout(function () {
    map.invalidateSize(true);
  }, 300);
}

function seleccionarSucursalDestino(codSucursal) {
  const $combo = $("#sucursalDestino2");

  const timer = setInterval(function () {
    const $opt = $combo.find('option.' + codSucursal);

    if ($opt.length) {
      $opt.prop("selected", true);
      $combo.trigger("change"); // dispara mapa
      clearInterval(timer);
    }
  }, 100);

  // safety
  setTimeout(() => clearInterval(timer), 3000);
}						   
