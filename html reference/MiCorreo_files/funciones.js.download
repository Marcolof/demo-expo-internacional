    if(!$("#pickup-dias").hasClass("border border-danger") && !$("#pickup-razon").hasClass("border border-danger") && !$("#pickup-mail").hasClass("border border-danger") && !$("#pickup-localidad").hasClass("border border-danger")&& !$("#pickup-calle").hasClass("border border-danger")&& !$("#pickup-cp").hasClass("border border-danger")&& !$("#pickup-celular").hasClass("border border-danger")&& !$("#pickup-provincia").hasClass("border border-danger")
    ){
        $("#mensajeErrorDomicilioPickup").addClass("d-none");
    }
});
