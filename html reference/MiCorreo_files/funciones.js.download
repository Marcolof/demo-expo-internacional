function alert2(mensaje,fxaceptar,hash){
    var idcuerpo = ((hash!=undefined)&&(hash["idcuerpo"]!=undefined))?hash["idcuerpo"]:"mensajeModalBodyGen";
	var idmodal = ((hash!=undefined)&&(hash["idmodal"]!=undefined))?hash["idmodal"]:"myModalGenerico";
	var idbotones = ((hash!=undefined)&&(hash["idbotones"]!=undefined))?hash["idbotones"]:"mensajeModalFooterGen";
	var idtitle = ((hash!=undefined)&&(hash["idtitle"]!=undefined))?hash["idtitle"]:"mensajeModalTitleGen";
	var lblTitle = ((hash!=undefined)&&(hash["lblTitle"]!=undefined))?hash["lblTitle"]:"Mensaje";	
	
	if (hash != undefined && hash['botonX'] != undefined) {
        //$(".btn-close").css("display", hash['botonX']);
		$('#btnX').css(hash['botonX']);
	}
    if (hash && hash['extraClass']) {
        $('#' + idmodal).find('.modal-dialog').addClass(hash['extraClass']);
    } else {
        $('#' + idmodal).find('.modal-dialog').removeClass('modal-fulfillment');
    }
	$("#"+idtitle).html(lblTitle);
	// console.log(idtitle)
	// console.log(lblTitle)

	var lblAceptar = ((hash!=undefined)&&(hash["lblAceptar"]!=undefined))?hash["lblAceptar"]:"Aceptar";
	var lblCancelar = ((hash!=undefined)&&(hash["lblCancelar"]!=undefined))?hash["lblCancelar"]:"Cancelar";
	
	var botones = '';
	
	if ((hash!=undefined)&&(hash["entendido"]!=undefined)){
	botones +='<p class="alineacion d-flex justify-content-center col-12"><input class="mx-2" type="checkbox" id="entendido" name="entendido">No volver a mostrar <label for="entendido"></p></label>';
	}

    if ((hash!=undefined)&&(hash["fxCancelar"]!=undefined)){
		var onclickevento = "";
		if (hash["fxCancelar"] != " ")
		onclickevento = ' onclick="' + hash["fxCancelar"] + '" ';
		botones += '<button type="button" class="btn btn-correo-secondary" ' + onclickevento + ' data-bs-dismiss="modal">'+lblCancelar+'</button>';
	}
    
	if (fxaceptar == undefined || fxaceptar == "")
	botones += '<button type="button" class="btn btn-correo-primary" data-bs-dismiss="modal">'+lblAceptar+'</button>';
	else
	botones += '<button type="button" class="btn btn-correo-primary" onclick="'+ fxaceptar +'" data-bs-dismiss="modal">'+lblAceptar+'</button>';
	

	
	$(document).on('keypress', function(r){    if (r.keyCode==27){ $('#'+idmodal).modal('toggle')};  $(document).off('keypress');  })
	
	
	$("#"+idbotones).html(botones);
	$("#"+idcuerpo).html(mensaje);
	$("#"+idmodal).modal("show");
	$(".modal-content").fadeIn(500);

}

function ValidacionLogin(evento)
{
    var email = $("#email");
    var password = $("#password");
    var btnPassword = $("#btnPassword");
    var span= $("#mensajeError");

    if(email.val() == "" || password.val() == "" ){
        span.removeClass("d-none");
        evento.preventDefault();
        
        if(email.val() == ""){
            email.addClass("border border-danger")
        }
        if(password.val() == ""){
            password.addClass("border border-danger")
            btnPassword.addClass("border border-danger");
        }
    }
}
