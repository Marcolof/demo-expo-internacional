const checkFieldsComplete = (_elem) => {
    //hide errors span
    $('#' + _elem + '-errors').addClass('d-none');
    $('#' + _elem + ' input').removeClass('border border-danger');
    $('#' + _elem + ' select').removeClass('border border-danger');

    let fail = false;

    fail = checkFields(_elem);

    //show errors span
    if (fail)
        $('#' + _elem + '-errors').removeClass('d-none');

    return fail;
}

const registerPaqAr = (route) => {

    let token = $("input[name=_token]").val();
    let $btn = $('#btn-register-paqar');

    if(checkFieldsComplete("form-paqar"))
        return false;

    // disabled current btn
    $btn.attr("disabled", "disabled");
    $btn.find(".text").html("Validando");

    $.ajax({
        url: route + '/enviarMailPuntoPaqar',
        type: "POST",
        dataType: 'html',
        data: $('#form-paqar').serialize(),
        headers: {
            'x-csrf-token': token
        },
        // complete: function( data ) {
            success: function( data ) {

                console.log(data);
            $btn.find(".text").html("Registrate");

            // open the modal
            $("#registerpaqar-modal-complete").modal('show');
        },
        error: function (xhr, status, error) {
            // enabled current btn
            $btn.removeAttr("disabled");
            $btn.find(".text").html("Registrate");

            var err = eval("(" + xhr.responseText + ")");

            if(err['g-recaptcha-response']) {
                var item = err['g-recaptcha-response'][0];

                $("#form-paqar-errors").empty()
                $("#form-paqar-errors").append("<small class='text-danger fw-semibold'>* " + item + "</small>")
                $("#form-paqar-errors").removeClass("d-none");
            } else {
                $("#form-paqar-errors").addClass("d-none");
            }
            
        }
    });
}

const initRegisterPaqAr = (selfUrl) => {
    applyMaskFields('form-paqar');

    $('#btn-register-paqar').click(function(e) {
        e.preventDefault();
        registerPaqAr(selfUrl);
    });

    // redirect home
    $("#registerpaqar-modal-complete").on('hide.bs.modal', function(){
        location.href = selfUrl;
    });
}
