const ATTRIBUTION_STORAGE_KEY = 'micorreo_campaign_attribution';
const ATTRIBUTION_TTL_MS = 30 * 24 * 60 * 60 * 1000;
const ATTRIBUTION_PARAMS = [
    'utm_source',
    'utm_medium',
    'utm_campaign',
    'utm_id',
    'utm_term',
    'utm_content',
    'gclid',
    'fbclid'
];

const captureCampaignAttribution = () => {
    const urlParams = new URLSearchParams(window.location.search);
    let captured = {};
    let hasNew = false;

    ATTRIBUTION_PARAMS.forEach((param) => {
        const value = urlParams.get(param);
        if (value) {
            captured[param] = value;
            hasNew = true;
        }
    });

    if (!hasNew) {
        return;
    }

    let stored = null;
    try {
        const raw = localStorage.getItem(ATTRIBUTION_STORAGE_KEY);
        if (raw) {
            stored = JSON.parse(raw);
        }
    } catch (e) {
        stored = null;
    }

    const now = Date.now();
    if (stored && stored.expiresAt && stored.expiresAt > now && stored.data) {
        captured = Object.assign({}, stored.data, captured);
    }

    if (!captured.lead_capture_date) {
        captured.lead_capture_date = new Date().toISOString();
    }

    localStorage.setItem(ATTRIBUTION_STORAGE_KEY, JSON.stringify({
        data: captured,
        expiresAt: now + ATTRIBUTION_TTL_MS
    }));
};

const getStoredCampaignAttribution = () => {
    try {
        const raw = localStorage.getItem(ATTRIBUTION_STORAGE_KEY);
        if (!raw) {
            return {};
        }
        const stored = JSON.parse(raw);
        if (!stored.expiresAt || stored.expiresAt <= Date.now()) {
            localStorage.removeItem(ATTRIBUTION_STORAGE_KEY);
            return {};
        }
        return stored.data || {};
    } catch (e) {
        return {};
    }
};

const appendAttributionToFormData = (formData) => {
    const attribution = getStoredCampaignAttribution();
    Object.keys(attribution).forEach((key) => {
        if (attribution[key]) {
            formData += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(attribution[key]);
        }
    });
    return formData;
};

captureCampaignAttribution();

