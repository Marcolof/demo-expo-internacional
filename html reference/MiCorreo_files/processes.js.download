function validarDatosAfip(texto){var htmlinputs='<div style="padding-top:10px;padding-bottom:26px;" class="form-group">';htmlinputs+='		<div class="col-sm-12">';htmlinputs+='			<div class="form-group">';htmlinputs+='				<input class="form-control" style="min-width:230px;" maxlength="190" id="password_actinfocliente" placeholder="Ingrese su contraseña" type="password" value="" />';htmlinputs+='			</div>';htmlinputs+='		</div>';htmlinputs+='</div>';if(texto!=undefined){htmlinputs+='<div style="padding-top:10px;padding-bottom:26px;" class="form-group">';htmlinputs+='		<div class="col-sm-12">';htmlinputs+='			<div class="form-group">';htmlinputs+='				<span style="color:crimson;padding-top:10px;margin-top: 13px !important;">'+texto+'</span>';htmlinputs+='			</div>';htmlinputs+='		</div>';htmlinputs+='</div>';}
confirm2("<br>¿Esta seguro que desea actualizar su informaci&oacute;n?<br>"+htmlinputs,"confirmActualizaInfoAfip();");}
function confirmActualizaInfoAfip(){if(myTrim($("#password_actinfocliente").val())==""){validarDatosAfip("Debe ingresar su contrase&ntilde;a");return;}
loading();var poststr='_token = '+el_token+'&pwd='+$("#password_actinfocliente").val();window.jQuery.ajax({type:"POST",url:la_url+'/actualizainfocliente',data:poststr,dataType:'json',success:function(result){unloading();var mensaje="";if(result==undefined||result.msg==undefined)
mensaje="Ocurrió un error, intentalo nuevamente.";else
mensaje=result.msg;alert2(mensaje);},error:function(XMLHttpRequest,textStatus,errorThrown){unloading();on_error_session(XMLHttpRequest,textStatus,errorThrown);},dataFilter:function(data,type){return data;}});}
function getSaldo(){var poststr='_token = '+el_token;$(".spMontoSaldo").html("Cargando...");window.jQuery.ajax({type:"GET",url:la_url+'/getsaldo',data:poststr,dataType:'json',success:function(result){var mensaje="";if(result==undefined||result.saldo==undefined)
mensaje="Hubo un error, intentelo nuevamente.";else{if(result.error=="2"){alert("Hubo un error, vuelva a intentarlo.");logout();return;}else if(result.error=="1"){mensaje=result.msg;}else{mensaje=result.saldo;$(".dvSaldoMonto").html(result.saldo);}}
$(".spMontoSaldo").html(mensaje);},error:function(XMLHttpRequest,textStatus,errorThrown){$(".spMontoSaldo").html("Hubo un error, intentelo nuevamente.");}});}
function irPanel(){loading();setTimeout("window.location.href='"+la_url+"/dashboard';",500);}
function getSaldoCC(){var poststr='_token = '+el_token;$(".spMontoSaldoCC").html("Cargando...");window.jQuery.ajax({type:"GET",url:la_url+'/getsaldoCC',data:poststr,dataType:'json',success:function(result){var mensaje="";if(result==undefined||result.saldo==undefined)
mensaje="Hubo un error, intentelo nuevamente.";else{if(result.error=="2"){alert("Hubo un error, vuelva a intentarlo.");logout();return;}else if(result.error=="1"){mensaje=result.msg;}else{mensaje=result.saldo;}}
$(".spMontoSaldoCC").html(mensaje);},error:function(XMLHttpRequest,textStatus,errorThrown){$(".spMontoSaldoCC").html("Hubo un error, intentelo nuevamente.");}});}