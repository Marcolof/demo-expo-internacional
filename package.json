{
  "name": "micorreo-maqueta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Maqueta web navegable de MiCorreo — Paquetería Internacional. Réplica funcional de UX, sin backend real.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:breakpoints": "node scripts/check-breakpoints.mjs",
    "check:ui": "npm run check:breakpoints && npm run typecheck"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
